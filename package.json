{
  "name": "request-x",
  "version": "3.0.5",
  "private": true,
  "description": "Request X",
  "homepage": "https://github.com/gera2ld/request-x#readme",
  "bugs": {
    "url": "https://github.com/gera2ld/request-x/issues"
  },
  "license": "MIT",
  "author": "Gerald <gera2ld@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gera2ld/request-x.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check": "vue-tsc && vitest --run && oxlint --fix && oxfmt",
    "assets": "node scripts/assets.mjs",
    "dev:background": "NODE_ENV=development vite build --watch",
    "dev:content": "NODE_ENV=development ENTRY=content vite build --watch",
    "dev": "pnpm assets && pnpm run /^dev:/",
    "build:background": "vite build",
    "build:content": "ENTRY=content vite build",
    "build:connector": "ENTRY=connector vite build && tsc -p src/connector/tsconfig.json",
    "build": "pnpm check && pnpm assets clean && pnpm /^build:/ && pnpm assets",
    "test": "vitest --run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@unocss/reset": "66.8.1",
    "@violentmonkey/shortcut": "^1.4.4",
    "codemirror": "^6.0.2",
    "es-toolkit": "^1.51.0",
    "vue": "^3.5.41",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.519",
    "@types/webextension-polyfill": "^0.12.5",
    "@unocss/postcss": "66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "husky": "^9.1.7",
    "jimp": "^1.6.1",
    "js-yaml": "^5.3.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss-nesting": "^14.0.1",
    "typescript": "^6.0.3",
    "unocss": "66.8.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,json,jsonc,json5,yaml,yml,md,mdx,html,graphql}": "oxfmt"
  },
  "engines": {
    "node": ">=26"
  }
}
